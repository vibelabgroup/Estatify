# ============================================
# Application Configuration
# ============================================

# GEMINI_API_KEY: Required for Gemini AI API calls
GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL: The URL where this application is hosted
# For Hostinger VPS: https://estatify.ai
APP_URL=https://estatify.ai

# Node Environment
NODE_ENV=production

# ============================================
# Hostinger Webmail Configuration
# ============================================

# SMTP Settings for Hostinger Webmail
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@estatify.ai
SMTP_PASS=your_email_password

# IMAP Settings for Hostinger Webmail
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=your-email@estatify.ai
IMAP_PASS=your_email_password

# From address for outgoing emails
EMAIL_FROM=noreply@estatify.ai
EMAIL_FROM_NAME=Estatify

# ============================================
# Backend Email Lead Management System
# ============================================

# Database Configuration
DB_USER=estatify_admin
DB_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_32_CHARS_MIN

# JWT Authentication
JWT_SECRET=CHANGE_THIS_JWT_SECRET_64_CHARS_MIN_RANDOM
JWT_EXPIRES_IN=7d

# Frontend URL for tracking
FRONTEND_URL=https://estatify.ai

# Email Accounts (Hostinger) - Multi-account rotation
SMTP_ACCOUNT_1=dan@estatify.ai
SMTP_PASSWORD_1=CHANGE_THIS_DAN_PASSWORD
SMTP_ACCOUNT_2=nico@estatify.ai
SMTP_PASSWORD_2=CHANGE_THIS_NICO_PASSWORD

# Email Limits
EMAIL_RATE_LIMIT=50
DAILY_EMAIL_LIMIT=100

# Application
PORT=3000
LOG_LEVEL=info
